{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nabra",
  "version": "2.0.1",
  "identifier": "app.nabra.v2",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pill",
        "url": "pill.html",
        "width": 64,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "hub",
        "url": "hub.html",
        "title": "Nabra",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
