{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows",
  "description": "Pill and hub: receive events, call Nabra commands; the frameless hub draws its own title bar.",
  "windows": ["pill", "hub", "meeting"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized"
  ]
}
